# Copy to .env and edit. Everything has a safe default for local development.
TRACKB_SECRET_KEY=change-me-to-a-long-random-string
TRACKB_ENV=development            # set to "production" to enable secure cookies
TRACKB_DB=instance/trackb.db
TRACKB_ADMIN_EMAIL=admin@trackb.in
TRACKB_ADMIN_PASSWORD=Admin@1234  # change before going live
TRACKB_GPS_KEY=change-me-gps-key  # devices/drivers send this in the X-GPS-Key header
TRACKB_DEMO_FLEET=1               # 1 = a demo bus is always on the road (8x time-lapse)
TRACKB_PARCEL_DEMO_MINUTES=1      # 1 = parcel stages advance in minutes (demo); 0 = real hours
TRACKB_SEED_DEMO=1                # 1 = create the demo traveller account and sample trips
